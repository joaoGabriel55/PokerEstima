<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#b4512f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#6a2b16" media="(prefers-color-scheme: dark)" />
    <%
      const seoTitle = typeof pageTitle !== "undefined" ? pageTitle : "PokerEstima";
      const seoDescription = typeof pageDescription !== "undefined" ? pageDescription : "Free online planning poker (scrum poker) for remote teams. Share one link, vote on story points in secret, reveal together. No sign-up, nothing to install.";
      const seoUrl = siteUrl + (typeof ogPath !== "undefined" ? ogPath : typeof canonicalPath !== "undefined" ? canonicalPath : "/");
    %>
    <title><%= seoTitle %></title>
    <meta name="description" content="<%= seoDescription %>" />
    <% if (typeof canonicalPath !== "undefined") { %>
      <link rel="canonical" href="<%= siteUrl + canonicalPath %>" />
    <% } %>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PokerEstima" />
    <meta property="og:title" content="<%= seoTitle %>" />
    <meta property="og:description" content="<%= seoDescription %>" />
    <meta property="og:url" content="<%= seoUrl %>" />
    <meta property="og:image" content="<%= siteUrl %>/public/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PokerEstima: free planning poker for teams on a call" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <% if (typeof isHome !== "undefined" && isHome) { %>
      <script type="application/ld+json"><%- JSON.stringify([
        {
          "@context": "https://schema.org",
          "@type": "WebApplication",
          name: "PokerEstima",
          url: siteUrl + "/",
          description: seoDescription,
          applicationCategory: "BusinessApplication",
          operatingSystem: "Any (web browser)",
          browserRequirements: "Requires JavaScript",
          isAccessibleForFree: true,
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
          featureList: [
            "Votes hidden until the facilitator reveals",
            "No sign-up or install",
            "Up to 10 people per room",
            "Average, nearest card and vote split after the reveal",
            "Rooms delete themselves after 10 minutes"
          ],
          screenshot: siteUrl + "/public/og-image.png"
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: { "@type": "Answer", text: item.answer }
          }))
        }
      ]).replace(/</g, "\\u003c") %></script>
    <% } %>
    <script>
      // Theme before first paint: follow the system unless the rail toggle chose one.
      // A choice that matches the system is forgotten, so the page follows it again.
      (function () {
        var KEY = "pokerestima-theme";
        var COLORS = { light: "#b4512f", dark: "#6a2b16" };
        var root = document.documentElement;
        var system = window.matchMedia("(prefers-color-scheme: dark)");

        function stored() {
          try {
            var value = localStorage.getItem(KEY);
            return value === "light" || value === "dark" ? value : null;
          } catch (error) {
            return null;
          }
        }

        function current() {
          return root.dataset.theme || (system.matches ? "dark" : "light");
        }

        function sync() {
          var theme = current();
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) {
            metas[i].content = root.dataset.theme ? COLORS[theme] : COLORS[metas[i].media.indexOf("dark") > -1 ? "dark" : "light"];
          }
          var toggle = document.querySelector("[data-theme-toggle]");
          if (toggle) {
            var label = theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
            toggle.setAttribute("aria-label", label);
            toggle.title = label;
          }
        }

        function apply(theme) {
          if (theme) root.dataset.theme = theme;
          else delete root.dataset.theme;
          sync();
        }

        apply(stored());
        system.addEventListener("change", function () {
          if (!stored()) apply(null);
        });
        document.addEventListener("DOMContentLoaded", sync);
        document.addEventListener("click", function (event) {
          if (!event.target.closest("[data-theme-toggle]")) return;
          var next = current() === "dark" ? "light" : "dark";
          var follows = next === (system.matches ? "dark" : "light");
          try {
            if (follows) localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, next);
          } catch (error) {}
          apply(follows ? null : next);
        });
      })();
    </script>
    <link rel="icon" href="/public/flag.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/public/apple-touch-icon.png" />
    <link rel="preload" href="/public/fonts/marcellus-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/public/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <% if (typeof inRoom !== "undefined" && inRoom) { %>
      <script src="https://cdn.socket.io/4.8.3/socket.io.min.js" integrity="sha384-kzavj5fiMwLKzzD1f8S7TeoVIEi7uKHvbTA3ueZkrzYq75pNQUiUi6Dy98Q3fxb0" crossorigin="anonymous"></script>
    <% } %>
    <link rel="stylesheet" href="/public/styles.css" />
  </head>
  <body>
    <header class="rail">
      <div class="rail-inner">
        <a class="wordmark" href="/" aria-label="PokerEstima home">
          <img class="wordmark-flag" src="/public/flag.svg" alt="" width="36" height="24" />
          <span class="wordmark-name">PokerEstima</span>
        </a>
        <p class="rail-tagline">Estimate your tasks with fun!</p>
        <div class="rail-slot"><%- defineContent('rail') %></div>
        <% if (typeof inRoom === "undefined" || !inRoom) { %>
          <a class="rail-support" href="https://ko-fi.com/O5I528IC3A" target="_blank" rel="noopener" aria-label="Support PokerEstima on Ko-fi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 8h13v5.5a5.5 5.5 0 0 1-5.5 5.5H9a5.5 5.5 0 0 1-5.5-5.5z" />
              <path d="M16.5 10H18a2.75 2.75 0 0 1 0 5.5h-1.5" />
              <path d="M10 15.75s-2.75-1.6-2.75-3.4a1.4 1.4 0 0 1 2.75-.55 1.4 1.4 0 0 1 2.75.55c0 1.8-2.75 3.4-2.75 3.4z" fill="currentColor" stroke="none" />
            </svg>
            <span class="rail-support-label">Support on Ko-fi</span>
          </a>
        <% } %>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
          </svg>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </header>

    <main class="page">
      <%- body %>
    </main>

    <p class="sr-only" id="announcer" role="status"></p>

    <div class="toasts">
      <div class="toast" id="toast" role="status">
        <span id="toastMessage"></span>
      </div>
      <div class="toast toast-error" id="errorToast" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
        </svg>
        <span id="errorToastMessage"></span>
      </div>
    </div>

    <script src="/public/script.js"></script>
  </body>
</html>
